# העתק ל-application.properties והתאם ערכים (או השתמש במשתני סביבה)
# אל תעלה מפתחות אמיתיים ל-Git!

spring.application.name=rag-llm
server.port=8080

spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

spring.datasource.url=jdbc:postgresql://localhost:5432/rag_llm
spring.datasource.username=postgres
spring.datasource.password=postgres
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.show-sql=false
logging.level.org.springframework.web=INFO

# חובה: הגדר משתנה סביבה GEMINI_API_KEY (מפתח מ-https://aistudio.google.com/apikey)
gemini.api-key=${GEMINI_API_KEY}
gemini.base-url=https://generativelanguage.googleapis.com
gemini.model=gemini-2.0-flash

# אופציונלי: JWT_SECRET לפרודקשן (ברירת מחדל לפיתוח בלבד)
jwt.secret=${JWT_SECRET:rag-llm-dev-secret-min-32-chars-change-in-prod}
jwt.expiration-ms=86400000
